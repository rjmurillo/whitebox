<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>Whitebox.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyInfo.cs uses a wildcard AssemblyVersion, which needs a non-deterministic build. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Transitionals">
      <HintPath>..\References\Transitionals\Transitionals.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Autofac" Version="3.1.1" />
    <PackageReference Include="Autofac.Configuration" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Whitebox.ico" />
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whitebox\Whitebox.csproj" />
    <ProjectReference Include="..\Whitebox.Core\Whitebox.Core.csproj" />
  </ItemGroup>

</Project>
